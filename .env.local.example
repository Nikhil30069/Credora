# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_jwt_anon_key_here

# One-time schema apply (npm run db:apply)
# Easiest: paste Session pooler URI from Dashboard → Connect → Session mode
# DATABASE_URL=postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional: try this region first if you know it (skips scanning)
# SUPABASE_POOLER_REGION=ap-south-1

# Optional: BIN lookup (signup). Include contact info if you hit rate limits — https://binlist.net/
# BIN_LOOKUP_USER_AGENT=Credora/1.0 (you@yourdomain.com)

# Google OAuth is configured in Supabase dashboard, not here.
# See: Authentication → Providers → Google
